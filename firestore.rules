rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isProfileVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true
        || request.auth.token.phone_number is string
        || (
          exists(/databases/$(database)/documents/autostyle_users/$(request.auth.uid))
          && (
            get(/databases/$(database)/documents/autostyle_users/$(request.auth.uid)).data.emailVerified == true
            || get(/databases/$(database)/documents/autostyle_users/$(request.auth.uid)).data.phoneVerified == true
            || get(/databases/$(database)/documents/autostyle_users/$(request.auth.uid)).data.verified == true
            || get(/databases/$(database)/documents/autostyle_users/$(request.auth.uid)).data.isVerified == true
          )
        )
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ["vadimm461@gmail.com", "vadimm462@gmail.com"]
        || (
          exists(/databases/$(database)/documents/autostyle_users/$(request.auth.uid))
          && get(/databases/$(database)/documents/autostyle_users/$(request.auth.uid)).data.role == "admin"
        )
      );
    }

    function hasPermission(permission) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/autostyle_users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/autostyle_users/$(request.auth.uid)).data.role == "admin"
          || get(/databases/$(database)/documents/autostyle_users/$(request.auth.uid)).data.permissions[permission] == true
        );
    }

    /* ═══════════════════════════════════════════════
       ТОВАРЫ И КОНТЕНТ — чтение всем, запись админам
       ═══════════════════════════════════════════════ */
    match /autostyle_products/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_categories/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_banners/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_settings/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_pages/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_media/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_homeBlocks/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_promoCards/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_home_blocks/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_promo_cards/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_home_cards/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_horizontal_promo_cards/{document=**} { allow read: if true; allow write: if isAdmin(); }

    /* ═══════════════════════════════════════════════
       ПОЛЬЗОВАТЕЛИ — закрыли дверь для самоповышения
       ═══════════════════════════════════════════════ */
    match /autostyle_users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      // При создании профиля роль может быть только 'user' или отсутствовать
      allow create: if isSignedIn() 
        && request.auth.uid == userId
        && (request.resource.data.role == "user" || !("role" in request.resource.data));
      
      // При обновлении роль нельзя менять (только админ может)
      allow update: if isSignedIn() && (
        isAdmin()
        || (
          request.auth.uid == userId 
          && request.resource.data.role == resource.data.role
        )
      );
      
      allow delete: if isAdmin();
    }

    /* ═══════════════════════════════════════════════
       ЗАКАЗЫ — только верифицированные, только свои
       ═══════════════════════════════════════════════ */
    match /autostyle_orders/{orderId} {
      allow create: if isProfileVerified();
      allow read: if isAdmin() || (
        isProfileVerified() && (
          resource.data.userId == request.auth.uid
          || resource.data.uid == request.auth.uid
        )
      );
      allow update, delete: if isAdmin();
    }

    /* ═══════════════════════════════════════════════
       СКИДОЧНЫЕ КАРТЫ — только админ создаёт/меняет
       ═══════════════════════════════════════════════ */
    match /autostyle_discount_cards/{cardId} {
      // Только админ может создавать/изменять карты.
      // Если пользователь активирует карту в профиле — делайте это через Cloud Function.
      allow create, update, delete: if isAdmin();
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.userId == request.auth.uid
        || resource.data.uid == request.auth.uid
      );
    }

    match /autostyle_discountCards/{cardId} {
      allow create, update, delete: if isAdmin();
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.userId == request.auth.uid
        || resource.data.uid == request.auth.uid
      );
    }

    /* ═══════════════════════════════════════════════
       ГРУППЫ ПОЛЬЗОВАТЕЛЕЙ
       ═══════════════════════════════════════════════ */
    match /autostyle_user_groups/{groupId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    /* ═══════════════════════════════════════════════
       УВЕДОМЛЕНИЯ — убрали групповые из общего доступа
       ═══════════════════════════════════════════════ */
    match /autostyle_notifications/{notificationId} {
      // Чтение: только админ, личные, или общие (all). 
      // Групповые (group) убраны — их лучше дублировать в персональные через Cloud Function.
      allow read: if isAdmin()
        || (
          isSignedIn()
          && (
            resource.data.audience == "all"
            || resource.data.userId == request.auth.uid
            || resource.data.uid == request.auth.uid
            || resource.data.userEmail == request.auth.token.email
          )
        );

      // Создание только админом или системой колеса (через CF)
      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.audience == "user"
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdBy == "wheel-system"
          && (request.resource.data.type == "wheel_win" || request.resource.data.type == "wheel_ready")
        );
      
      allow update, delete: if isAdmin();
    }

    match /autostyle_notification_reads/{userId} {
      allow read, create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    /* ═══════════════════════════════════════════════
       ОБРАТНАЯ СВЯЗЬ
       ═══════════════════════════════════════════════ */
    match /autostyle_feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.userId == request.auth.uid
        || resource.data.uid == request.auth.uid
        || resource.data.userEmail == request.auth.token.email
      );
      allow update, delete: if isAdmin();
    }

    /* ═══════════════════════════════════════════════
       АНАЛИТИКА — ЗАКРЫТА. Переводите на Cloud Function.
       ═══════════════════════════════════════════════ */
    match /autostyle_page_views/{document=**} {
      allow create: if false;  // Клиент больше не пишет сюда
      allow read, update, delete: if isAdmin();
    }

    match /autostyle_events/{document=**} {
      allow create: if false;  // Клиент больше не пишет сюда
      allow read, update, delete: if isAdmin();
    }

    match /autostyle_online_sessions/{sessionId} {
      allow create, update: if false;  // Клиент больше не пишет сюда
      allow read, delete: if isAdmin();
    }

    /* ═══════════════════════════════════════════════
       ТОВАРНАЯ АНАЛИТИКА
       ═══════════════════════════════════════════════ */
    match /autostyle_product_snapshots/{document=**} { allow read, write: if isAdmin(); }
    match /autostyle_product_changes/{document=**} { allow read, write: if isAdmin(); }
    match /autostyle_lost_products/{document=**} { allow read, write: if isAdmin(); }
    match /autostyle_purchase_recommendations/{document=**} { allow read, write: if isAdmin(); }
    match /autostyle_product_sync_runs/{document=**} { allow read, write: if isAdmin(); }
    match /autostyle_inventory_history/{document=**} { allow read, write: if isAdmin(); }
    match /autostyle_top_products/{document=**} { allow read, write: if isAdmin(); }

    /* ═══════════════════════════════════════════════
       КОЛЕСО ФОРТУНЫ — призы только через Cloud Function
       ═══════════════════════════════════════════════ */
    match /autostyle_wheel_config/{configId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /autostyle_wheel_state/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /autostyle_wheel_prizes/{prizeId} {
      // Призы создаются только админом или Cloud Function (через Admin SDK)
      allow create: if false;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    /* ═══════════════════════════════════════════════
       СТАРЫЕ КОЛЛЕКЦИИ
       ═══════════════════════════════════════════════ */
    match /site/{document=**} { allow read: if true; allow write: if isAdmin() || hasPermission("legacyAdmin"); }
    match /products/{document=**} { allow read: if true; allow write: if isAdmin() || hasPermission("legacyAdmin"); }
    match /categories/{document=**} { allow read: if true; allow write: if isAdmin() || hasPermission("legacyAdmin"); }
    match /banners/{document=**} { allow read: if true; allow write: if isAdmin() || hasPermission("legacyAdmin"); }
    match /promoCards/{document=**} { allow read: if true; allow write: if isAdmin() || hasPermission("legacyAdmin"); }
    match /homeCards/{document=**} { allow read: if true; allow write: if isAdmin() || hasPermission("legacyAdmin"); }

    match /users/{userId} {
      allow read, update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
    }

    match /salary/{document=**} { allow read, write: if isAdmin() || hasPermission("staffSalary") || hasPermission("legacyAdmin"); }
  }
}

