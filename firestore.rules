rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/autostyle_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/autostyle_users/$(request.auth.uid)).data.role == "admin";
    }

    /* ===== СТАРЫЙ САЙТ ===== */

    match /site/{document=**} { allow read, write: if true; }
    match /products/{document=**} { allow read, write: if true; }
    match /salary/{document=**} { allow read, write: if true; }
    match /users/{userId} { allow read, write: if isSignedIn(); }
    match /categories/{document=**} { allow read, write: if true; }
    match /banners/{document=**} { allow read, write: if true; }

    /* ===== AUTOSTYLE ===== */

    match /autostyle_products/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_categories/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_banners/{document=**} { allow read: if true; allow write: if isAdmin(); }

    match /autostyle_users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /autostyle_settings/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_pages/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_media/{document=**} { allow read: if true; allow write: if isAdmin(); }

    /* ===== БЛОКИ / БАННЕРЫ / ПРОМО ===== */

    match /autostyle_homeBlocks/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_home_blocks/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_homeSettings/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_home_settings/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_homeSections/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_home_sections/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_home_cards/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_promoCards/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /autostyle_promo_cards/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /promoCards/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /homeCards/{document=**} { allow read: if true; allow write: if isAdmin(); }


    match /autostyle_notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ===== ЗАКАЗЫ ===== */

    match /autostyle_orders/{orderId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    /* ===== СКИДОЧНЫЕ КАРТЫ ===== */

    match /autostyle_discount_cards/{cardId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid || cardId == request.auth.uid);
      allow update: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid || cardId == request.auth.uid);
      allow delete: if isAdmin();
    }

    /* старая версия имени коллекции, чтобы не ломались уже созданные карты */
    match /autostyle_discountCards/{cardId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid || cardId == request.auth.uid);
      allow update: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid || cardId == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
